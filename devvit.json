              "destination-1-url": {
                "type": "string",
                "label": "Webhook URL",
                "helpText": "Optional Discord or Slack webhook URL.",
                "validationEndpoint": "/internal/settings/validate-webhook-url"
              },
              "destination-1-events": {
                "type": "multiSelect",
                "label": "Event Types",
                "defaultValue": [
                  "all"
                ],
                "options": [
                  {
                    "label": "All",
                    "value": "all"
