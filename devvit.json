      "modqueue-relay": {
        "type": "group",
        "label": "Modqueue Relay",
        "helpText": "Scans the full modqueue once per minute. An item must pass every configured count, age, report, and content filter.",
        "fields": {
          "modqueue-enabled": {
            "type": "boolean",
            "label": "Enabled",
            "defaultValue": false
          },
          "modqueue-content-type": {
            "type": "select",
