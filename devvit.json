      "unmoderated-relay": {
        "type": "group",
        "label": "Unmoderated Relay",
        "helpText": "Control how unmoderated posts and comments are selected and relayed.",
        "fields": {
          "relay-behavior": {
            "type": "group",
            "label": "Relay Behavior",
            "helpText": "Relay eligible content immediately or scan top posts once per minute. Front Page mode does not relay comments.",
            "fields": {
              "unmoderated-enabled": {
                "type": "boolean",
                "label": "Enabled",
                "defaultValue": true
              },
              "relay-mode": {
                "type": "select",
                "label": "Relay Mode",
                "helpText": "Choose when to relay unmoderated posts and comments.",
                "defaultValue": "immediately",
                "options": [
                  {
                    "label": "Immediately",
                    "value": "immediately"
                  },
                  {
                    "label": "Front Page",
                    "value": "front-page"
                  }
                ]
              },
              "front-page-time-frame": {
                "type": "select",
                "label": "Front Page Time Frame",
                "helpText": "Choose the time frame for front page relay mode.",
                "defaultValue": "hour",
                "options": [
                  {
                    "label": "Hour",
                    "value": "hour"
                  },
                  {
                    "label": "Day",
                    "value": "day"
                  },
                  {
                    "label": "Week",
                    "value": "week"
                  },
                  {
                    "label": "Month",
                    "value": "month"
                  },
                  {
                    "label": "Year",
                    "value": "year"
                  },
                  {
                    "label": "All",
                    "value": "all"
                  }
                ]
              }
            }
          },
          "discord-role-ping": {
            "type": "group",
            "label": "Discord Role Ping",
            "helpText": "Applies only to Discord destinations; enter the numeric role ID to mention it in unmoderated relays.",
            "fields": {
              "ping-role": {
                "type": "boolean",
                "label": "Ping Discord Role",
                "defaultValue": false
              },
              "ping-role-id": {
                "type": "string",
                "label": "Discord Role ID"
              }
            }
          },
          "included-content": {
            "type": "group",
            "label": "Included Content",
            "helpText": "Content Type and Only Approved Authors must pass. If username, flair text, or flair template ID filters are configured, matching any one includes the item.",
            "fields": {
              "content-type": {
                "type": "select",
                "label": "Content Type",
                "defaultValue": "post",
                "options": [
                  {
                    "label": "All",
                    "value": "all"
                  },
                  {
                    "label": "Posts Only",
                    "value": "post"
                  },
                  {
                    "label": "Comments Only",
                    "value": "comment"
                  }
                ]
              },
              "specific-username": {
                "type": "string",
                "label": "Username(s)/Moderators Only",
                "helpText": "Username without u/ or m for all moderators. Separate multiple values with commas."
              },
              "user-flair": {
                "type": "string",
                "label": "User Flair Text"
              },
              "user-flair-template-id": {
                "type": "string",
                "label": "User Flair Template ID",
                "helpText": "Comma-separated user flair template IDs; each value is matched exactly."
              },
              "post-flair": {
                "type": "string",
                "label": "Post Flair Text"
              },
              "post-flair-template-id": {
                "type": "string",
                "label": "Post Flair Template ID",
                "helpText": "Comma-separated post flair template IDs; each value is matched exactly. Applies only to posts."
              },
              "only-approved-users": {
                "type": "boolean",
                "label": "Only Approved Authors",
                "defaultValue": false
              }
            }
          },
          "excluded-content": {
            "type": "group",
            "label": "Excluded Content",
            "helpText": "Matching any username, flair text, flair template ID, or author-status exclusion skips the item, even when an inclusion filter matches.",
            "fields": {
              "ignore-specific-username": {
                "type": "string",
                "label": "Ignore Username(s)/Moderators"
              },
              "ignore-user-flair": {
                "type": "string",
                "label": "Ignore User Flair Text"
              },
              "ignore-user-flair-template-id": {
                "type": "string",
                "label": "Ignore User Flair Template ID",
                "helpText": "Comma-separated user flair template IDs to exclude; each value is matched exactly."
              },
              "ignore-post-flair": {
                "type": "string",
                "label": "Ignore Post Flair Text"
              },
              "ignore-post-flair-template-id": {
                "type": "string",
                "label": "Ignore Post Flair Template ID",
                "helpText": "Comma-separated post flair template IDs to exclude; each value is matched exactly. Applies only to posts."
              },
              "ignore-shadowbanned": {
                "type": "boolean",
                "label": "Ignore Shadowbanned or Deleted Authors",
                "defaultValue": false
              }
            }
          },
          "timing-and-approval": {
            "type": "group",
            "label": "Timing and Approval",
            "helpText": "A delay of 0 is disabled; other delays must be at least 3 minutes. Approval delays apply to retries, and the score threshold applies to Front Page posts.",
            "fields": {
              "comment-delay": {
                "type": "number",
                "label": "Comment Delay Minutes",
                "defaultValue": 0,
                "validationEndpoint": "/internal/settings/validate-delay"
              },
              "post-delay": {
                "type": "number",
                "label": "Post Delay Minutes",
                "defaultValue": 0,
                "validationEndpoint": "/internal/settings/validate-delay"
              },
              "ignore-removed": {
                "type": "boolean",
                "label": "Ignore Removed Items",
                "defaultValue": false
              },
              "retry-on-approval": {
                "type": "boolean",
                "label": "Retry On Approval",
                "defaultValue": false
              },
              "comment-delay-after-approval": {
                "type": "number",
                "label": "Comment Delay After Approval Minutes",
                "defaultValue": 0,
                "validationEndpoint": "/internal/settings/validate-delay"
              },
              "post-delay-after-approval": {
                "type": "number",
                "label": "Post Delay After Approval Minutes",
                "defaultValue": 0,
                "validationEndpoint": "/internal/settings/validate-delay"
              },
              "post-score-threshold": {
                "type": "number",
                "label": "Post Score Threshold",
                "defaultValue": 0
              }
            }
          },
          "safety-and-embeds": {
            "type": "group",
            "label": "Safety and Embeds",
            "helpText": "Choose whether to relay from submit events instead of waiting for Reddit safety checks, and whether to suppress unmoderated item or author link previews.",
            "fields": {
              "skip-safety-checks": {
                "type": "boolean",
                "label": "Skip Reddit Safety Checks",
                "defaultValue": false
              },
              "suppress-item-embed": {
                "type": "boolean",
                "label": "Suppress Item Embed",
                "defaultValue": false
              },
              "suppress-author-embed": {
                "type": "boolean",
                "label": "Suppress Author Embed",
                "defaultValue": false
              }
            }
          }
        }
      },
      "modmail-relay": {
        "type": "group",
        "label": "Modmail Relay",
        "helpText": "Forward new conversations, non-moderator messages, or all messages.",
        "fields": {
          "modmail-enabled": {
