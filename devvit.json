{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "discord-relay",
  "marketingAssets": {
    "icon": "assets/discord-relay.png"
  },
  "sourceIgnores": [
    ".codex",
    ".github",
    ".idea"
  ],
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "scripts": {
    "build": "npm run build:server",
    "dev": "npm run watch:server"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "discord.com",
        "discordapp.com",
        "hooks.slack.com"
      ]
    },
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "redis": true
  },
  "settings": {
