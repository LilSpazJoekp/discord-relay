            ]
          },
          "modqueue-minimum-report-count": {
            "type": "number",
            "label": "Minimum Report Count",
            "defaultValue": 0
          },
          "modqueue-minimum-age-minutes": {
            "type": "number",
            "label": "Minimum Age Minutes",
            "defaultValue": 0
          },
          "modqueue-maximum-age-minutes": {
            "type": "number",
            "label": "Maximum Age Minutes",
            "defaultValue": 0
          },
          "modqueue-report-contains": {
            "type": "string",
            "label": "Report Contains",
            "helpText": "Comma-separated case-insensitive keywords."
          },
          "modqueue-content-contains": {
            "type": "string",
            "label": "Post/Comment Body or Title Contains",
            "helpText": "Comma-separated case-insensitive keywords."
          },
          "modqueue-only-mod-reported": {
            "type": "boolean",
            "label": "Only Forward Mod Reported Items",
            "defaultValue": false
          }
        }
      },
      "reported-content-relay": {
        "type": "group",
        "label": "Reported Content Relay",
        "helpText": "Forwards report events as they arrive. Report type and minimum count must pass unless a moderator report is configured to bypass the minimum.",
        "fields": {
          "reported-enabled": {
            "type": "boolean",
            "label": "Enabled",
            "defaultValue": false
          },
          "reported-report-type": {
            "type": "select",
            "label": "Report Type",
            "defaultValue": "all",
            "options": [
              {
                "label": "All",
                "value": "all"
              },
              {
                "label": "Mod Report Only",
                "value": "mod-only"
              },
              {
                "label": "User Reports Only",
                "value": "user-only"
              }
            ]
          },
          "reported-minimum-report-count": {
            "type": "number",
            "label": "Minimum Report Count",
            "defaultValue": 0
          },
          "reported-mod-reports-bypass-minimum": {
            "type": "boolean",
            "label": "Mod Reports Bypass Minimum Count",
            "defaultValue": false
          }
        }
      },
      "modlog-relay": {
        "type": "group",
        "label": "Modlog Relay",
        "fields": {
          "modlog-enabled": {
            "type": "boolean",
            "label": "Enabled",
            "defaultValue": false
